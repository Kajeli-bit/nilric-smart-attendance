# Google OAuth (Google Cloud Console)
# 1) APIs & Services → OAuth consent screen (External; add Test users if Testing)
# 2) Credentials → Create OAuth client ID → Web application
# 3) Authorized JavaScript origins:
#      https://YOUR-SITE.netlify.app
#      http://localhost:8888
# 4) Authorized redirect URIs:
#      https://YOUR-SITE.netlify.app/api/auth/callback/google
#      http://localhost:8888/api/auth/callback/google
# 5) Copy Client ID + Client Secret below, then redeploy Netlify
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Auth.js session secret (openssl rand -base64 32)
AUTH_SECRET=replace-with-random-32-byte-base64

# Comma-separated Google emails allowed to open /admin
ADMIN_EMAILS=you@gmail.com

# Office location + messaging
OFFICE_NAME=Nilric HQ
OFFICE_CITY=Dar es Salaam
OFFICE_PUBLIC_IP=203.0.113.10
OFFICE_LAT=-6.7924
OFFICE_LNG=39.2086
OFFICE_RADIUS_METERS=100
OFFICE_TIMEZONE=Africa/Dar_es_Salaam

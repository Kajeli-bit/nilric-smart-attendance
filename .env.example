# === Auth.js (required for Google SSO) ===
# Generate AUTH_SECRET: openssl rand -base64 32
AUTH_SECRET=replace-with-random-32-byte-base64

# Preferred Auth.js Google env names
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# Aliases still supported by this app
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Vercel reverse proxy — Auth.js does NOT auto-trust all hosts by default
AUTH_TRUST_HOST=true
# Production site URL (no trailing slash) — Vercel project domain
AUTH_URL=https://YOUR-PROJECT.vercel.app

# Comma-separated Google emails allowed to open /admin
ADMIN_EMAILS=you@gmail.com

# === Postgres (Vercel Marketplace → Neon Postgres) ===
# Injected automatically when you install Neon from the Vercel Marketplace.
# Locally: paste the pooled or direct connection string here.
POSTGRES_URL=postgres://user:password@host/dbname?sslmode=require
# Optional aliases accepted by the app / migrate script:
# DATABASE_URL=
# POSTGRES_URL_NON_POOLING=
# POSTGRES_PRISMA_URL=

# Office location + messaging
OFFICE_NAME=Nilric HQ
OFFICE_CITY=Dar es Salaam
OFFICE_PUBLIC_IP=203.0.113.10
OFFICE_LAT=-6.7924
OFFICE_LNG=39.2086
OFFICE_RADIUS_METERS=100
OFFICE_TIMEZONE=Africa/Dar_es_Salaam
